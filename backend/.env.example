# ⚠️  COPIA ESTE ARCHIVO COMO .env Y CAMBIA LOS VALORES POR DEFECTO
# ===============================================================
# Los valores que aparecen aquí son SOLO para desarrollo local.
# En producción debes cambiar: SECRET_KEY, POSTGRES_PASSWORD, TELEMETRY_API_KEY.

PROJECT_NAME="PPTMaps API"
API_V1_STR="/api/v1"

# Configuración de Base de Datos (PostgreSQL / PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
# ⚠️ CAMBIAR en producción
POSTGRES_PASSWORD=postgres
POSTGRES_DB=movimed
POSTGRES_PORT=5432

# Redis y Tareas en Segundo Plano
REDIS_URL=redis://localhost:6379/0

# Seguridad JWT
# ⚠️ CAMBIAR en producción — genera una clave con: openssl rand -hex 32
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 horas

# API key para ingesta de telemetría (dispositivos GPS)
# ⚠️ CAMBIAR en producción
TELEMETRY_API_KEY=dev-telemetry-key-change-me

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate Limiting para reportes ciudadanos
RATE_LIMIT_REPORTS=5/hour  # 5 reportes por hora por IP

# Opcional: desactiva las advertencias de valores por defecto en desarrollo
# DISABLE_DEV_WARNINGS=1
