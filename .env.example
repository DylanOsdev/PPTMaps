# === Servidor (copiar a servidor/.env) ===
NOMBRE_APP=MoviMed API
PREFIJO_API_V1=/api/v1
HOST=0.0.0.0
PUERTO=8000
# Orígenes CORS: * o lista separada por comas (tu IP o dominio)
ORIGENES_CORS=*

# PostgreSQL / PostGIS (nombre del servicio en Docker: db)
URL_BASE_DATOS=postgresql+psycopg://movimed:movimed@db:5432/movimed
URL_REDIS=redis://redis:6379/0
VERIFICAR_BD=true

# === Cliente (opcional, en index.html o consola del navegador) ===
# window.TPPMAPS_API = 'https://TU-SERVIDOR-IP:8000/api/v1'
